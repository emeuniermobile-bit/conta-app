{
  "expo": {
    "name": "Contamination",
    "slug": "contamination",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "contamination",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090E12",
    "ios": {
      "bundleIdentifier": "fr.contamination.app",
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.contamination.app",
      "adaptiveIcon": {
        "backgroundColor": "#090E12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090E12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Contamination utilise ta position approximative pour savoir si tu croises des zombies dans Paris.",
          "locationAlwaysAndWhenInUsePermission": "Avec « Toujours », le virus te suit même appli fermée : tes rencontres dans le métro ou dans la rue comptent sans ouvrir l'appli. Ta position est arrondie à 50 m et effacée après 6 h.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2EE6D6",
          "defaultChannel": "alerts"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
